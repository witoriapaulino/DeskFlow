  "item": [
    {
      "name": "RF02 — Login usuário",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario@deskflow.dev\",\n  \"senha\": \"Senha@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"retorna JWT\", () => pm.expect(r.accessToken).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"jwtUsuario\", r.accessToken);",
              "pm.collectionVariables.set(\"solicitanteId\", r.usuario.id);"
            ]
          }
        }
      ]
    },
