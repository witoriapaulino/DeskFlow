    {
      "name": "RF01 — Abrir chamado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtUsuario}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/chamados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chamados"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Impressora do 2º andar não imprime\",\n  \"descricao\": \"Desde hoje cedo a impressora mostra erro de papel atolado.\",\n  \"prioridade\": \"ALTA\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "const c = pm.response.json();",
              "pm.test(\"nasce ABERTO\", () => pm.expect(c.status).to.eql(\"ABERTO\"));",
              "pm.test(\"tem prazo de SLA\", () => pm.expect(c.prazoSla).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"chamadoId\", c.id);"
            ]
          }
        }
      ]
    },
