        "url": {
          "raw": "{{baseUrl}}/chamados/{{chamadoId}}/atribuicao",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chamados",
            "{{chamadoId}}",
            "atribuicao"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tecnicoId\": {{tecnicoId}},\n  \"prioridade\": \"CRITICA\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const c = pm.response.json();",
              "pm.test(\"em atendimento\", () => pm.expect(c.status).to.eql(\"EM_ATENDIMENTO\"));",
              "pm.test(\"prioridade crítica\", () => pm.expect(c.prioridade).to.eql(\"CRITICA\"));"
            ]
          }
        }
      ]
